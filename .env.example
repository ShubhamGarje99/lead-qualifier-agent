# Copy to .env and fill in. Everything is optional: with no key the pipeline
# runs in OFFLINE mode (heuristic extraction + template drafts).

# Enables LLM mode (Claude structured-output extraction + drafting, LLM-judge evals)
ANTHROPIC_API_KEY=

# Model overrides (defaults shown)
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_JUDGE_MODEL=claude-haiku-5-5
# Server-side refusal fallback on Sonnet requests: on (default) | off
# CLAUDE_FALLBACKS=on

# auto (LLM if a key is set, else offline) | offline | llm
# LEADQ_MODE=auto

# Real Slack delivery (Block Kit). Unset = append to outbox/slack.jsonl
SLACK_WEBHOOK_URL=

# HubSpot adapter. Unset = dry-run (payloads logged, nothing sent).
# Only used when LEADQ_CRM=hubspot; default CRM is the local SQLite mock.
HUBSPOT_TOKEN=
# LEADQ_CRM=sqlite

# If set, POST /webhook/lead requires header
#   X-Leadq-Signature: sha256=<hex HMAC-SHA256 of the raw body>
WEBHOOK_SECRET=
